# Django secret key. It is recommended to generate a new one for production.
SECRET_KEY=your-super-secret-key-here

# Set to True for development, False for production.
DEBUG=True

# URL for the external User Service
USER_SERVICE_URL=http://127.0.0.1:8001/api/user/

# --- Database Configuration ---
# Use 'postgresql' for production and 'sqlite3' for simple local development.
DATABASE_ENGINE=postgresql

# PostgreSQL settings (only used if DATABASE_ENGINE is 'postgresql')
POSTGRES_DB=chat_db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis Configuration ---
# Used for Django Channels layer
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
REDIS_CAPACITY=100
